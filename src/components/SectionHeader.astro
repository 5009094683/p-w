---
interface Props {
  eyebrow?: string;
  title: string;
  id?: string;
}

const { eyebrow, title, id } = Astro.props;
---

<div class="max-w-3xl">
  {eyebrow && <p class="eyebrow" data-md-skip>{eyebrow}</p>}
  <h2 id={id} class="display mt-3 text-[clamp(2rem,1.5rem+2.2vw,3.25rem)]">{title}</h2>
  {
    Astro.slots.has('default') && (
      <div class="mt-4 space-y-3 text-muted">
        <slot />
      </div>
    )
  }
</div>
