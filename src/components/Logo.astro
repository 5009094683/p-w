---
import { MONOGRAM } from '@/lib/brand.ts';

interface Props {
  class?: string;
  /** Accessible name. Leave out when the logo sits next to visible text that names it. */
  label?: string;
}

const { class: className, label } = Astro.props;
---

<svg
  class={className}
  viewBox={MONOGRAM.viewBox}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <path d={MONOGRAM.path}></path>
</svg>
