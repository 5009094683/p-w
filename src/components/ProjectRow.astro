---
import Icon from '@/components/Icon.astro';
import ProjectMeta from '@/components/ProjectMeta.astro';
import { projectPath, type Project } from '@/data/projects.ts';
import { repoSnapshot } from '@/lib/github.ts';

interface Props {
  project: Project;
  /** Heading level of the project name. */
  level?: 'h2' | 'h3';
}

const { project, level: Heading = 'h3' } = Astro.props;
const repo = repoSnapshot(project.repo);
const internal = projectPath(project);
const href = internal ?? repo?.url ?? project.url;
---

<article class="group relative grid gap-x-8 gap-y-3 border-t border-line py-7 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
  <div>
    <Heading class="display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">
      <a href={href} class="stretched rounded-sm">
        <span class="bg-no-repeat transition-[background-size] duration-200 [background-image:linear-gradient(var(--accent),var(--accent))] [background-position:0_88%] [background-size:0%_0.3em] group-hover:[background-size:100%_0.3em]">
          {project.name}
        </span>
      </a>
    </Heading>
    <p class="mt-2 max-w-2xl text-muted">{project.tagline}</p>
  </div>
  <div class="flex items-center gap-5 md:justify-end">
    <ProjectMeta project={project} />
    <Icon
      name={internal ? 'lucide:arrow-right' : 'lucide:arrow-up-right'}
      size="1.25rem"
      class="hidden shrink-0 text-muted transition-colors group-hover:text-ink md:block"
    />
  </div>
</article>
