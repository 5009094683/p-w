---
import type { GetStaticPaths } from 'astro';
import ContactBand from '@/components/ContactBand.astro';
import Icon from '@/components/Icon.astro';
import PageHeader from '@/components/PageHeader.astro';
import ProjectRow from '@/components/ProjectRow.astro';
import Base from '@/layouts/Base.astro';
import { pages, projectPageMeta } from '@/data/pages.ts';
import { githubStats } from '@/data/profile.ts';
import { detailProjects, type Project } from '@/data/projects.ts';
import { formatLongDate, formatMonthYear, formatNumber } from '@/lib/format.ts';
import { repoSnapshot, showsCounts } from '@/lib/github.ts';
import { ids, pageGraph, projectNode } from '@/lib/schema.ts';

export const getStaticPaths = (() =>
  detailProjects.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const detail = project.detail!;
const meta = projectPageMeta(project);
const repo = repoSnapshot(project.repo);
const asOf = githubStats().asOfLabel;
const license = detail.licenseNote ?? repo?.license;

// Two other projects to read next: the neighbors in the list, wrapping around.
const position = detailProjects.indexOf(project);
const more = [1, 2].map((offset) => detailProjects[(position + offset) % detailProjects.length]!);

const counted = showsCounts(repo);

const facts: { label: string; value: string; href?: string }[] = repo
  ? [
      ...(counted ? [{ label: 'Stars', value: formatNumber(repo.stars) }] : []),
      ...(counted ? [{ label: 'Forks', value: formatNumber(repo.forks) }] : []),
      ...(repo.language ? [{ label: 'Language', value: repo.language }] : []),
      ...(license ? [{ label: 'License', value: license, href: detail.licenseUrl }] : []),
      { label: 'First published', value: formatLongDate(repo.createdAt) },
      { label: 'Last updated', value: formatLongDate(repo.pushedAt) },
      { label: 'Repository', value: repo.fullName, href: repo.url },
    ]
  : [
      { label: 'Made by', value: 'YBX Labs', href: 'https://ybxlabs.com' },
      { label: 'Website', value: new URL(project.url!).host, href: project.url },
      ...(detail.timeline?.[0] ? [{ label: 'Started', value: formatMonthYear(detail.timeline[0].date) }] : []),
      { label: 'Price', value: 'Free tier, with paid plans' },
    ];

const graph = pageGraph({
  path: meta.path,
  title: meta.title,
  description: meta.description,
  type: 'ItemPage',
  about: ids.project(project.slug),
  mainEntity: ids.project(project.slug),
  trail: [
    { name: pages.projects.label, path: pages.projects.path },
    { name: project.name, path: meta.path },
  ],
  nodes: [projectNode(project)],
});
---

<Base meta={meta} graph={graph}>
  <PageHeader
    title={project.name}
    trail={[
      { name: pages.projects.label, path: pages.projects.path },
      { name: project.name, path: meta.path },
    ]}
  >
    <p>{project.tagline}</p>
  </PageHeader>

  <div class="shell grid gap-x-14 gap-y-12 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="measure space-y-12">
      <section class="space-y-5 text-lg" aria-label="Overview">
        {detail.intro.map((paragraph) => <p>{paragraph}</p>)}
        {
          detail.basedOn && (
            <p class="text-base text-muted">
              Builds on <a href={detail.basedOn.url} class="link">{detail.basedOn.name}</a>.
            </p>
          )
        }
      </section>

      <section aria-labelledby="features">
        <h2 id="features" class="display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">What it does</h2>
        <ul class="mt-6 space-y-3">
          {
            detail.features.map((feature) => (
              <li class="flex gap-3">
                <Icon name="lucide:check" size="1.125rem" class="mt-1.5 shrink-0 text-muted" />
                <span>{feature}</span>
              </li>
            ))
          }
        </ul>
      </section>

      {
        detail.sections?.map((section) => (
          <section>
            <h2 class="display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">{section.heading}</h2>
            <div class="mt-5 space-y-4">
              {section.body.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
          </section>
        ))
      }

      {
        detail.timeline && (
          <section aria-labelledby="timeline">
            <h2 id="timeline" class="display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">
              Timeline
            </h2>
            <ol class="mt-6 border-t border-line">
              {detail.timeline.map((entry) => (
                <li class="grid gap-x-8 gap-y-1 border-b border-line py-4 sm:grid-cols-[9rem_minmax(0,1fr)]">
                  <time datetime={entry.date} class="text-sm font-medium text-muted sm:pt-0.5">
                    {formatMonthYear(entry.date)}
                  </time>
                  <span>{entry.label}</span>
                </li>
              ))}
            </ol>
          </section>
        )
      }

      <section aria-labelledby="stack">
        <h2 id="stack" class="display text-[clamp(1.75rem,1.4rem+1.4vw,2.5rem)]">Built with</h2>
        <ul class="mt-6 flex flex-wrap gap-2">
          {
            detail.stack.map((item) => (
              <li class="tag">{item}</li>
            ))
          }
        </ul>
      </section>
    </div>

    <aside class="lg:pt-1" aria-label="Project facts">
      <ul class="flex flex-wrap gap-3">
        {
          project.url && (
            <li>
              <a href={project.url} class="btn btn-primary">
                {repo ? 'Open the live version' : `Visit ${project.name}`}
                <Icon name="lucide:arrow-up-right" size="1rem" />
              </a>
            </li>
          )
        }
        {
          repo && (
            <li>
              <a href={repo.url} class:list={['btn', project.url ? 'btn-ghost' : 'btn-primary']}>
                <Icon name="simple-icons:github" size="1rem" />
                View on GitHub
              </a>
            </li>
          )
        }
      </ul>

      <table class="mt-8 w-full text-[0.9375rem]">
        <caption class="sr-only">{project.name}: key facts</caption>
        <tbody>
          {
            facts.map((fact) => (
              <tr class="border-b border-line first:border-t">
                <th scope="row" class="py-3 pr-4 text-left align-top font-normal text-muted">
                  {fact.label}
                </th>
                <td class="py-3 text-right align-top font-medium [overflow-wrap:anywhere]">
                  {fact.href ? (
                    <a href={fact.href} class="link">
                      {fact.value}
                    </a>
                  ) : (
                    fact.value
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
      {counted && <p class="mt-3 text-[0.8125rem] text-muted">Stars and forks as counted on GitHub on {asOf}.</p>}

      {
        detail.links && (
          <div class="mt-8">
            <h2 class="eyebrow">Links</h2>
            <ul class="mt-3 space-y-2 text-[0.9375rem]">
              {detail.links.map((link) => (
                <li>
                  <a href={link.url} class="link">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </aside>
  </div>

  <section class="shell mt-24 sm:mt-32" aria-labelledby="more">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 id="more" class="eyebrow">More projects</h2>
      <a href="/projects" class="link text-[0.9375rem] font-medium">All projects</a>
    </div>
    <div class="mt-4 border-b border-line">
      {more.map((item) => <ProjectRow project={item} />)}
    </div>
  </section>

  <ContactBand title="Want to talk about this project?" />
</Base>
