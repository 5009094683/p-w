---
import '@/styles/global.css';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import serifFont from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import type { Graph } from 'schema-dts';
import Footer from '@/components/Footer.astro';
import Header from '@/components/Header.astro';
import type { PageMeta } from '@/data/pages.ts';
import { person } from '@/data/profile.ts';
import { SITE, absoluteUrl, markdownPath } from '@/data/site.ts';
import { SPECULATION_RULES, THEME_SCRIPT } from '@/lib/inline.ts';
import { OG_IMAGE, ROBOTS_INDEX, ROBOTS_NOINDEX, ogImageUrl, serializeForScript } from '@/lib/seo.ts';

interface Props {
  meta: PageMeta;
  /** JSON-LD for the page. */
  graph?: Graph;
  ogType?: 'website' | 'profile' | 'article';
  /** Overrides `meta.noindex`, for pages whose status depends on content. */
  noindex?: boolean;
  article?: { published: Date; updated?: Date; tags?: string[] };
}

const { meta, graph, ogType = 'website', article } = Astro.props;
const noindex = Astro.props.noindex ?? meta.noindex ?? false;
const canonical = absoluteUrl(meta.path);
const ogImage = ogImageUrl(meta.path);
const ogImageAlt = `${meta.ogTitle} ${person.name}, ${person.role}.`;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content={person.name} />
    <meta name="robots" content={noindex ? ROBOTS_NOINDEX : ROBOTS_INDEX} />
    {!noindex && <link rel="canonical" href={canonical} />}

    <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />

    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={SITE.themeColor.light} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={SITE.themeColor.dark} media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.ogLocale} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content={OG_IMAGE.type} />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    <meta property="og:image:alt" content={ogImageAlt} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content={person.givenName} />
          <meta property="profile:last_name" content={person.familyName} />
          <meta property="profile:username" content={person.handle} />
        </>
      )
    }
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          <meta property="article:modified_time" content={(article.updated ?? article.published).toISOString()} />
          <meta property="article:author" content={absoluteUrl('/about')} />
          {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={`@${person.handle}`} />
    <meta name="twitter:creator" content={`@${person.handle}`} />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {
      !noindex && (
        <link rel="alternate" type="text/markdown" href={markdownPath(meta.path)} title="This page as Markdown" />
      )
    }
    <link rel="alternate" type="application/rss+xml" href="/feed.xml" title={`${SITE.name}: writing (RSS)`} />
    <link rel="alternate" type="application/atom+xml" href="/feed.atom" title={`${SITE.name}: writing (Atom)`} />
    <link rel="alternate" type="application/feed+json" href="/feed.json" title={`${SITE.name}: writing (JSON Feed)`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt: a guide to this site for language models" />
    <link rel="alternate" type="application/json" href="/profile.json" title="Machine-readable profile" />

    <script is:inline data-cfasync="false" set:html={THEME_SCRIPT} />
    <script is:inline type="speculationrules" set:html={SPECULATION_RULES} />
    {graph && <script is:inline type="application/ld+json" set:html={serializeForScript(graph)} />}
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to content</a>
    <div class="rule-signature" aria-hidden="true"></div>
    <Header current={meta.path} />
    <main id="content" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
